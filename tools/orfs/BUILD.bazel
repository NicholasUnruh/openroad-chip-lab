load("//:openroad.bzl", "orfs_flow", "orfs_gds")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "klayout_local",
    srcs = ["klayout_local.sh"],
)

orfs_flow(
    name = "mac8",
    arguments = {
        "CORE_UTILIZATION": "35",
        "PLACE_DENSITY": "0.55",
    },
    pdk = "@orfs//flow:sky130hd",
    sources = {"SDC_FILE": [":constraints.sdc"]},
    verilog_files = [":mac8.v"],
)

orfs_gds(
    name = "mac8_gds",
    klayout = ":klayout_local",
    src = ":mac8_final",
)

orfs_flow(
    name = "training_tile_v4",
    arguments = {
        "CAP_MARGIN": "25",
        "CORE_UTILIZATION": "35",
        "PLACE_DENSITY": "0.55",
        "SLEW_MARGIN": "25",
    },
    pdk = "@orfs//flow:sky130hd",
    sources = {"SDC_FILE": [":training_tile_v4.sdc"]},
    verilog_files = [":training_tile_v4.v"],
)

orfs_gds(
    name = "training_tile_v4_gds",
    klayout = ":klayout_local",
    src = ":training_tile_v4_final",
)

SKY130_SRAM = "@orfs//flow:platforms/sky130ram/sky130_sram_1rw1r_128x256_8/sky130_sram_1rw1r_128x256_8"

orfs_flow(
    name = "training_tile_v6",
    arguments = {
        "CAP_MARGIN": "25",
        "CORE_AREA": "10 10 1690 1690",
        "DIE_AREA": "0 0 1700 1700",
        "MACRO_PLACE_HALO": "20 20",
        "PLACE_DENSITY": "0.55",
        "SLEW_MARGIN": "25",
    },
    pdk = "@orfs//flow:sky130hd",
    sources = {
        "ADDITIONAL_GDS": [SKY130_SRAM + ".gds"],
        "ADDITIONAL_LEFS": [SKY130_SRAM + ".lef"],
        "ADDITIONAL_LIBS": [SKY130_SRAM + "_TT_1p8V_25C.lib"],
        "MACRO_PLACEMENT_TCL": [":scratchpad_macro.tcl"],
        "PDN_TCL": [":scratchpad_pdn.tcl"],
        "SDC_FILE": [":training_tile_v6.sdc"],
    },
    verilog_files = [":training_tile_v6.v"],
)

orfs_gds(
    name = "training_tile_v6_gds",
    klayout = ":klayout_local",
    src = ":training_tile_v6_final",
)

# V6's flow and clock; the die grows to 1,800 um so the larger MX datapath lands at about
# V6's 52% utilization (macro included).
orfs_flow(
    name = "training_tile_v7",
    arguments = {
        "CAP_MARGIN": "25",
        "CORE_AREA": "10 10 1790 1790",
        "DIE_AREA": "0 0 1800 1800",
        "MACRO_PLACE_HALO": "20 20",
        "PLACE_DENSITY": "0.55",
        "SLEW_MARGIN": "25",
    },
    pdk = "@orfs//flow:sky130hd",
    sources = {
        "ADDITIONAL_GDS": [SKY130_SRAM + ".gds"],
        "ADDITIONAL_LEFS": [SKY130_SRAM + ".lef"],
        "ADDITIONAL_LIBS": [SKY130_SRAM + "_TT_1p8V_25C.lib"],
        "MACRO_PLACEMENT_TCL": [":scratchpad_macro.tcl"],
        "PDN_TCL": [":scratchpad_pdn.tcl"],
        "SDC_FILE": [":training_tile_v7.sdc"],
    },
    verilog_files = [":training_tile_v7.v"],
)

orfs_gds(
    name = "training_tile_v7_gds",
    klayout = ":klayout_local",
    src = ":training_tile_v7_final",
)

# ASAP7 predictive 7 nm PPA harnesses for the numerics study (docs/numerics-study.md).
[orfs_flow(
    name = top,
    # The FMA's routed wires overshot the 320 ps slew limit by up to 52% on 2026-11-13.
    arguments = {
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY": "0.60",
    } | ({"SLEW_MARGIN": "25"} if top == "ppa_fma_bf16" else {}),
    pdk = "@orfs//flow:asap7",
    sources = {"SDC_FILE": [":ppa_asap7.sdc"]},
    verilog_files = [":" + top + ".v"],
) for top in [
    "ppa_fma_bf16",
    "ppa_dot8_bf16",
    "ppa_dot8_bf16_f24",
    "ppa_dot8_bf16_f28",
    "ppa_dot8_bf16_f36",
    "ppa_dot8_bf16_f40",
    "ppa_dot8_e4m3",
    "ppa_dot8_e5m2",
    "ppa_dot8_int8",
    "ppa_dot32_mxfp8",
    "ppa_dot32_mxfp4",
    "ppa_dot32_mxfp8_e5m2",
    "ppa_dot32_mxfp6_e3m2",
    "ppa_dot32_mxfp6_e2m3",
    "ppa_dot32_nvfp4",
]]

# The same harnesses in SKY130HD, to test whether the ASAP7 ranking holds in a real PDK.
[orfs_flow(
    name = "sky130_" + top,
    arguments = {
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY": "0.60",
    },
    pdk = "@orfs//flow:sky130hd",
    sources = {"SDC_FILE": [":ppa_sky130hd.sdc"]},
    top = top,
    verilog_files = [":" + top + ".v"],
) for top in [
    "ppa_dot8_bf16",
    "ppa_dot32_mxfp8",
    "ppa_dot32_mxfp6_e2m3",
]]
