#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
    printf 'error: expected at most one design\nhelp: bin/layout [mac8|training_tile]\n'
    exit 2
fi
case "${1:-mac8}" in
    --help) printf 'usage: bin/layout [mac8|training_tile]\ndefault: mac8\nhelp: run make layout-training to synthesize and route the training tile\n'; exit 0 ;;
    mac8|training_tile) design=${1:-mac8} ;;
    *) printf 'error: unknown design\nhelp: bin/layout [mac8|training_tile]\n'; exit 2 ;;
esac

lab_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tool_dir=${ORFS_TOOL_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/openroad-chip-lab/bazel-orfs}
tool_commit=a25cf9abcdc753b25e5e2d28487844556d8e6db2
source_file="$lab_dir/rtl/mac8.v"
constraint_file="$lab_dir/constraints/sky130hd.sdc"
constraint_name=constraints.sdc
output_dir="$lab_dir/build/layout"
if [ "$design" = training_tile ]; then
    source_file="$lab_dir/build/training_tile.v"
    constraint_file="$lab_dir/constraints/training_tile.sdc"
    constraint_name=training_tile.sdc
    output_dir="$lab_dir/build/layout-training"
    if [ ! -s "$source_file" ]; then
        printf 'error: training netlist is missing\nhelp: run make layout-training\n'
        exit 1
    fi
fi

command -v bazelisk >/dev/null 2>&1 || { printf '%s\n' 'bazelisk is required' >&2; exit 1; }
klayout_bin=$(command -v klayout) || { printf '%s\n' 'real KLayout is required for GDS' >&2; exit 1; }
case "$klayout_bin" in
    /*) ;;
    *) printf '%s\n' 'KLayout must resolve to an absolute executable path' >&2; exit 1 ;;
esac

if [ ! -d "$tool_dir/.git" ]; then
    mkdir -p "$(dirname "$tool_dir")"
    git clone --depth 1 https://github.com/The-OpenROAD-Project/bazel-orfs.git "$tool_dir"
    git -C "$tool_dir" fetch --depth 1 origin "$tool_commit"
    git -C "$tool_dir" checkout --detach "$tool_commit"
fi

if [ "$(git -C "$tool_dir" rev-parse HEAD)" != "$tool_commit" ]; then
    printf '%s\n' "OpenROAD tool checkout has an unexpected commit: $tool_dir" >&2
    exit 1
fi

mkdir -p "$tool_dir/chip-lab"
for filename in "$design.v" "$constraint_name" BUILD.bazel klayout_local.sh; do
    if [ -L "$tool_dir/chip-lab/$filename" ]; then
        printf '%s\n' "Refusing to overwrite symlink: $tool_dir/chip-lab/$filename" >&2
        exit 1
    fi
done
cp "$source_file" "$tool_dir/chip-lab/$design.v"
cp "$constraint_file" "$tool_dir/chip-lab/$constraint_name"
cp "$lab_dir/tools/orfs/BUILD.bazel" "$tool_dir/chip-lab/BUILD.bazel"
printf '#!/bin/sh\nexec "%s" "$@"\n' "$klayout_bin" > "$tool_dir/chip-lab/klayout_local.sh"
chmod +x "$tool_dir/chip-lab/klayout_local.sh"

cd "$tool_dir"
bazelisk build "//chip-lab:${design}_gds" --jobs="${ORFS_JOBS:-4}"

gds_file="$tool_dir/bazel-bin/chip-lab/results/sky130hd/$design/base/6_final.gds"
if [ ! -s "$gds_file" ]; then
    printf '%s\n' "GDS output is missing or empty: $gds_file" >&2
    exit 1
fi

mkdir -p "$output_dir"
for filename in "$design.gds" timing.rpt router_drc.rpt metrics.json; do
    if [ -L "$output_dir/$filename" ]; then
        printf '%s\n' "Refusing to overwrite a symlink: $filename" >&2
        exit 1
    fi
done
install -m 0644 "$gds_file" "$output_dir/$design.gds"
report_dir="$tool_dir/bazel-bin/chip-lab/reports/sky130hd/$design/base"
install -m 0644 "$report_dir/6_finish.rpt" "$output_dir/timing.rpt"
install -m 0644 "$report_dir/5_route_drc.rpt" "$output_dir/router_drc.rpt"
install -m 0644 "$tool_dir/bazel-bin/chip-lab/logs/sky130hd/$design/base/6_report.json" "$output_dir/metrics.json"
printf 'GDS: %s\n' "$output_dir/$design.gds"
